{
  "server": {
    "bindAddr": "0.0.0.0:50051",
    "httpBridgePort": 9110
  },
  "database": {
    "url": "postgresql://proyecta:CHANGE_ME@postgres:5432/identity?schema=public"
  },
  "encryptionKey": "k1.aesgcm256.REPLACE_WITH_GENERATED_CLOAK_KEY",
  "issuer": "proyecta",
  "audience": "proyecta",
  "keys": {
    "privateKeyPath": "/service/config/keys/private.pem",
    "publicKeyPath": "/service/config/keys/public.pem"
  },
  "tokens": {
    "accessTokenExpiresIn": "15m",
    "refreshTokenExpiresIn": "30d",
    "idTokenExpiresIn": "15m"
  },
  "security": {
    "contactVerificationRequired": false,
    "twoFactorAuthenticationRequired": false
  },
  "appUrl": "https://app.proyecta.do/sign-in",
  "invite": {
    "url": "https://app.proyecta.do/invitation",
    "failUrl": "https://app.proyecta.do/invitation-invalid",
    "expiration": "7d"
  },
  "smtp": {
    "host": "smtp.resend.com",
    "port": 465,
    "secure": true,
    "sender": "Proyecta <no-reply@proyecta.do>",
    "auth": {
      "user": "resend",
      "pass": "re_REPLACE_WITH_RESEND_API_KEY"
    }
  }
}
