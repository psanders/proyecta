#
# TLS-terminating reverse proxy for the Proyecta production stack. Routes by
# Host header to the dashboard, player and apiserver containers on the
# internal Docker network. Runs in the official nginx image, which expands
# ${APP_HOST}/${PLAY_HOST}/${API_HOST} from the container environment via its
# built-in envsubst-on-templates entrypoint (see compose.prod.yaml) before
# nginx starts — nginx's own "$host"-style variables are untouched because
# envsubst is restricted to names that exist as real environment variables.
#
# Unlike QCobro's Envoy proxy, this stack has no gRPC/WebSocket to pass
# through (the device protocol and tRPC subscriptions both ride plain SSE
# over HTTP/1.1), so a plain nginx TLS terminator is enough.
#
# This proxy listens on 443 ONLY (like QCobro's Envoy) — never on 80 — so
# port 80 stays free at all times for `certbot certonly --standalone`, on
# both first issuance and every renewal. See scripts/deploy/tls.sh.

# Resolve container names through Docker's embedded DNS on every request (cached 10s) instead of
# once at startup. With a literal `proxy_pass http://dashboard:80`, nginx keeps the IPs it saw when
# it started; a deploy that recreates dashboard and player can hand them each other's old IP, and
# app.proyecta.do then serves the player (happened with v0.2.0). A variable in proxy_pass forces
# the lookup through this resolver.
resolver 127.0.0.11 valid=10s ipv6=off;

# app.proyecta.do — owner dashboard
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Advertiser uploads (POST /uploads/assets) are up to 200 MB of video; the API enforces the
    # per-type limits itself. Stream the body through instead of spooling it here first.
    client_max_body_size 210m;
    proxy_request_buffering off;

    location / {
        set $upstream_dashboard http://dashboard:80;
        proxy_pass $upstream_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Off stack-wide (not just /trpc) so the tRPC SSE subscription
        # transport streams end to end; the dashboard/player containers are
        # otherwise small static bundles, so the cost is negligible.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}

# play.proyecta.do — player (paired screens)
server {
    listen 443 ssl;
    http2 on;
    server_name ${PLAY_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    location / {
        set $upstream_player http://player:80;
        proxy_pass $upstream_player;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}

# api.proyecta.do — direct device-protocol endpoint for shells (Android/kiosk)
# that talk to the API without loading the player SPA.
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    location / {
        set $upstream_apiserver http://apiserver:3000;
        proxy_pass $upstream_apiserver;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
