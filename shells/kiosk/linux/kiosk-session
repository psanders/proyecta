#!/bin/sh
# Copyright (C) 2026 by Proyecta. All rights reserved.
#
# Waits for the helper, then runs Chromium full screen under cage. LED panels driven by a PC
# window instead of a full screen set PROYECTA_WINDOW="x,y,width,height" in
# /etc/default/proyecta-kiosk.
set -eu

URL="http://127.0.0.1:47800/"
BROWSER="$(command -v chromium || command -v chromium-browser)"

# The helper normally starts first; wait up to 30 s in case it is still coming up.
i=0
until curl -fsS -o /dev/null "${URL}shell/info"; do
  i=$((i + 1))
  [ "$i" -ge 30 ] && break
  sleep 1
done

set -- --kiosk --noerrdialogs --disable-infobars --no-first-run \
  --autoplay-policy=no-user-gesture-required \
  --disable-features=Translate,TouchpadOverscrollHistoryNavigation \
  --check-for-update-interval=31536000 \
  --user-data-dir="/var/lib/proyecta/chromium" \
  --ozone-platform=wayland

if [ -n "${PROYECTA_WINDOW:-}" ]; then
  IFS=, read -r X Y W H <<EOF
$PROYECTA_WINDOW
EOF
  set -- "$@" --window-position="$X,$Y" --window-size="$W,$H"
fi

exec cage -s -- "$BROWSER" "$@" "$URL"
