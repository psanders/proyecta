    {
      "type": "frame",
      "id": "Pvu5l",
      "x": 11738,
      "y": 12185,
      "name": "note: web-home-mobile / La Red",
      "width": 360,
      "fill": "#FFF4D6",
      "cornerRadius": 8,
      "stroke": "#E0B84A",
      "strokeWidth": 1,
      "layout": "vertical",
      "gap": 12,
      "padding": 20,
      "children": [
        {
          "type": "text",
          "id": "r4Gtg",
          "name": "Heading",
          "fill": "#762F16",
          "content": "NOTA DE IMPLEMENTACIÓN · MÓVIL",
          "fontFamily": "$--font-primary",
          "fontSize": 12,
          "fontWeight": "700",
          "letterSpacing": 1.5
        },
        {
          "type": "text",
          "id": "sBBX4",
          "name": "Title",
          "fill": "#111111",
          "content": "Mapa arrastrable en «La Red»",
          "fontFamily": "$--font-secondary",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "S798N",
          "name": "Item 1",
          "fill": "#111111",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "— El usuario arrastra el mapa (ambos ejes) para ver Puerto Plata, Santiago y Punta Cana.",
          "lineHeight": 1.45,
          "fontFamily": "$--font-secondary",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "B8UCN",
          "name": "Item 2",
          "fill": "#111111",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "— Límite: los bordes del mapa. Nunca se ve espacio vacío dentro de la tarjeta.",
          "lineHeight": 1.45,
          "fontFamily": "$--font-secondary",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "CkP4X",
          "name": "Item 3",
          "fill": "#111111",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "— Inicia centrado en Santo Domingo, a la misma escala que este frame.",
          "lineHeight": 1.45,
          "fontFamily": "$--font-secondary",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "F3Aql1",
          "name": "Item 4",
          "fill": "#111111",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "— Pista «Arrastra para explorar» que desaparece tras el primer arrastre.",
          "lineHeight": 1.45,
          "fontFamily": "$--font-secondary",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "BDnK1",
          "name": "Item 5",
          "fill": "#111111",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "— El gesto solo se captura dentro de la tarjeta; fuera de ella la página hace scroll normal.",
          "lineHeight": 1.45,
          "fontFamily": "$--font-secondary",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "kQuVq",
          "name": "Item 6",
          "fill": "#111111",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "— Escritorio: mapa completo, estático, con los 4 pines.",
          "lineHeight": 1.45,
          "fontFamily": "$--font-secondary",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
