generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Which shell runs the player core on the physical device.
enum DeviceShell {
  ANDROID
  KIOSK_LINUX
  KIOSK_WINDOWS
  BROWSER

  @@map("device_shell")
}

/// A physical player. Its pairing code is permanent and tied to the hardware id.
model Device {
  id              String          @id @default(uuid()) @db.Uuid
  /// Canonical pairing code without the dash, e.g. 8F3K2QLM.
  code            String          @unique @db.Char(8)
  hwId            String          @unique @map("hw_id")
  shell           DeviceShell
  chromiumVersion String?         @map("chromium_version")
  resolution      String?
  lastSeenAt      DateTime        @default(now()) @map("last_seen_at")
  /// SHA-256 of the current device token (rotated on every registration).
  tokenHash       String?         @unique @map("token_hash")
  /// Last heartbeat payload (player version, codec, uptime, memory, storage, current item).
  health          Json?
  lastHeartbeatAt DateTime?       @map("last_heartbeat_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  bindings        DeviceBinding[]
  playLogs        PlayLog[]

  @@map("devices")
}

/// Kind of place where a screen is installed.
enum PlaceType {
  BILLBOARD
  MALL
  RESTAURANT
  SUPERMARKET
  HEALTH
  TRANSIT
  GYM
  OFFICE
  EDUCATION
  HOTEL
  OTHER

  @@map("place_type")
}

enum Environment {
  INDOOR
  OUTDOOR

  @@map("environment")
}

enum Orientation {
  LANDSCAPE
  PORTRAIT

  @@map("orientation")
}

enum PriceModel {
  PER_HOUR
  PER_DAY
  PER_WEEK
  PER_MONTH

  @@map("price_model")
}

enum ScreenStatus {
  ACTIVE
  ARCHIVED

  @@map("screen_status")
}

enum PlayResult {
  COMPLETED
  STALLED
  FAILED

  @@map("play_result")
}

/// A virtual screen a business publishes. Owned by an Identity workspace (WO… accessKeyId).
model Screen {
  id                   String          @id @default(uuid()) @db.Uuid
  workspaceAccessKeyId String          @map("workspace_access_key_id")
  name                 String
  placeType            PlaceType?      @map("place_type")
  environment          Environment?
  city                 String
  address              String?
  widthCm              Int?            @map("width_cm")
  heightCm             Int?            @map("height_cm")
  orientation          Orientation?
  resolution           String?
  /// ISO weekdays, 1 = Monday … 7 = Sunday.
  availableDays        Int[]           @map("available_days")
  /// "HH:MM", local time (America/Santo_Domingo).
  startTime            String?         @map("start_time")
  endTime              String?         @map("end_time")
  /// Reference price in whole Dominican pesos.
  priceReference       Int?            @map("price_reference")
  priceModel           PriceModel?     @map("price_model")
  status               ScreenStatus    @default(ACTIVE)
  deletedAt            DateTime?       @map("deleted_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  bindings             DeviceBinding[]
  playLogs             PlayLog[]

  @@index([workspaceAccessKeyId, status])
  @@map("screens")
}

/// Link history between physical devices and screens. At most one open link per device and per
/// screen is enforced by partial unique indexes (see the migration SQL).
model DeviceBinding {
  id         String    @id @default(uuid()) @db.Uuid
  deviceId   String    @map("device_id") @db.Uuid
  screenId   String    @map("screen_id") @db.Uuid
  linkedAt   DateTime  @default(now()) @map("linked_at")
  unlinkedAt DateTime? @map("unlinked_at")
  device     Device    @relation(fields: [deviceId], references: [id])
  screen     Screen    @relation(fields: [screenId], references: [id])

  @@index([deviceId, linkedAt])
  @@index([screenId, linkedAt])
  @@map("device_bindings")
}

/// One ad play reported by a device. Idempotent per device, item and start time.
model PlayLog {
  id        String     @id @default(uuid()) @db.Uuid
  deviceId  String     @map("device_id") @db.Uuid
  screenId  String?    @map("screen_id") @db.Uuid
  itemId    String     @map("item_id")
  codec     String
  result    PlayResult
  startedAt DateTime   @map("started_at")
  endedAt   DateTime   @map("ended_at")
  createdAt DateTime   @default(now()) @map("created_at")
  device    Device     @relation(fields: [deviceId], references: [id])
  screen    Screen?    @relation(fields: [screenId], references: [id])

  @@unique([deviceId, itemId, startedAt])
  @@index([screenId, startedAt])
  @@map("play_logs")
}
