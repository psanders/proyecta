{
  "name": "@proyecta/api",
  "version": "0.2.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./router": {
      "source": "./src/trpc/router.ts",
      "types": "./dist/trpc/router.d.ts",
      "default": "./dist/trpc/router.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "nodemon",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "mocha",
    "test:integration": "mocha --config .mocharc.integration.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@fonoster/identity-client": "^0.25.0",
    "@fonoster/logger": "^0.25.0",
    "@grpc/grpc-js": "~1.10.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@proyecta/common": "*",
    "@trpc/server": "^11.18.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.7",
    "prisma": "^7.10.0"
  }
}
